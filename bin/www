#!/usr/bin/env node

var app = require("../app");
var http = require("http");
const { initializeWebSocket } = require("../backend/websocket");
const { getActivePort, getBaseURL } = require("../backend/config");

// Port and base URL come from env vars or settings (see backend/config.js)
var port = getActivePort();
app.set("port", port);

var server = http.createServer(app);

// Live updates to open browser tabs (file changes, sequence changes)
initializeWebSocket(server);

// Listen on all network interfaces
server.listen(port);
server.on("error", onError);
server.on("listening", onListening);

function onError(error) {
  if (error.syscall !== "listen") {
    throw error;
  }

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case "EACCES":
      console.error(`Port ${port} requires elevated privileges`);
      process.exit(1);
      break;
    case "EADDRINUSE":
      console.error(`Port ${port} is already in use`);
      process.exit(1);
      break;
    default:
      throw error;
  }
}

function onListening() {
  const log = require("../backend/logger").tagged("STARTUP");
  let version = {};
  try {
    version = JSON.parse(require("fs").readFileSync(require("path").join(__dirname, "../version.json"), "utf8"));
  } catch {
    /* version.json missing */
  }
  const os = require("os");
  log.info(
    `Preroll Plus ${version.version ?? "?"} (${version.branch ?? "?"} branch, build ${process.env.BUILD || "Native"}) ` +
      `on Node ${process.versions.node}, ${os.platform()} ${os.release()} ${os.arch()}`,
  );
  const { CONFIG_DIR } = require("../backend/paths");
  log.info(`Listening on port ${port} at "${getBaseURL() || "/"}", settings and logs in ${CONFIG_DIR}`);
}
